# ============================================
# 生物科研工作台 · 服务端配置（全部可选）
# ============================================
# 重要说明：
#   本工作台默认「使用者自带 API Key」——公开分享时不需要在本文件填任何 Key，
#   使用者在网页右上角「模型设置」里自行填写，Key 只存在他自己的浏览器里。
#
#   下面的配置只在「自部署 / 本机调试」时使用，作为兜底默认值。
#   复制本文件为 .env 后填写；.env 已被 .gitignore 排除，不会进仓库。
# ============================================

# ---------- 对话模型兜底（OpenAI 兼容协议） ----------
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
# 留空 = 不下发 temperature（推荐）。部分模型只接受特定温度，写死会报 400。
KIMI_TEMPERATURE=

# ---------- 图片生成兜底 ----------
# IMAGE_MODE=async 用于任务制平台（提交后轮询，如 ToAPIs）；
# IMAGE_MODE=sync  用于标准 OpenAI /images/generations 同步接口。
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_MODE=async
# 相对 Base URL 的路径。Base URL 已含 /v1，这里不要再写 /v1。
IMAGE_PATH=/images/generations
IMAGE_SIZE=1:1

# ---------- 服务 ----------
PORT=8787
